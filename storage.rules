rules_version = '2';

// Profile photos only (shared spec: profile-photos-spec.md). Clients upload
// to their own folder; setProfilePhoto (server) moderates the file and writes
// the player doc. Files are deleted by the server only. Everything else is
// denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
