rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    // Check that only allowed fields are being changed (no extras)
    function onlyUpdates(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Ensure a field is unchanged between existing and new data
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Like unchanged(), but safe when the field is absent on either side.
    function unchangedOptional(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ─── Sport catalog ──────────────────────────────────
    // `config/sports.live` lists the sports that can be published right now
    // (see functions/src/config/sportsCatalog.ts). If the doc is missing, or
    // `live` isn't a list, fall back to the launch set — the same default the
    // apps bundle.
    //
    // Access-call budget: this does at most one exists() + one get() on the
    // same document (config/sports) per create. Firestore allows 10 document
    // access calls per single-document request (20 for batches/transactions),
    // and nothing else in these create rules calls get()/exists(), so we stay
    // far under the limit. Keep any new get() calls in mind if you extend this.
    function launchLiveSports() {
      return ['pickleball', 'badminton', 'tennis'];
    }

    // `liveMinAppVersion` holds sports that only newer app versions offer
    // (cricket needs teams). Older apps ignore it; for writes they count as live.
    function liveSportsFrom(cfg) {
      let base = cfg.data.get('live', null) is list ? cfg.data.live : launchLiveSports();
      let gated = cfg.data.get('liveMinAppVersion', null) is map ? cfg.data.liveMinAppVersion.keys() : [];
      return base.concat(gated);
    }

    function liveSports() {
      let cfgPath = /databases/$(database)/documents/config/sports;
      return exists(cfgPath) ? liveSportsFrom(get(cfgPath)) : launchLiveSports();
    }

    // Creates may omit sportType (legacy clients: means badminton). If it is
    // present it must be a currently live sport.
    function hasLiveSportOrNone() {
      return !('sportType' in request.resource.data)
        || request.resource.data.sportType in liveSports();
    }

    // Updates may keep the existing sportType (even one that is no longer live),
    // but may only change it to a currently live sport. The get() runs only
    // when sportType actually changes.
    function sportUnchangedOrLive() {
      return !('sportType' in request.resource.data)
        || ('sportType' in resource.data
            && request.resource.data.sportType == resource.data.sportType)
        || request.resource.data.sportType in liveSports();
    }

    // ─── Team sports ────────────────────────────────────
    // A cricket tournament is always a team event, and its registrations
    // must be team entries. Older app versions don't know the team format
    // and would otherwise register individuals (e.g. from a shared link).
    // One get() of the tournament per registration create, plus one
    // getAfter() of the entry lock for team events.
    function teamEntryIfTeamEvent(registrationId) {
      let t = get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId));
      return t.data.get('formatRaw', '') != 'team'
        || (isNonEmptyString(request.resource.data.get('teamId', ''))
            && isNonEmptyString(request.resource.data.get('teamName', ''))
            && request.resource.data.get('rosterIds', null) is list
            && !('partnerId' in request.resource.data)
            && holdsTeamEntryLock(registrationId));
    }

    // One team entry per person per tournament: a team registration must be
    // written in the same batch as teamEntries/{tournamentId}_{playerId}
    // (lower case), which can be created once and never overwritten.
    function teamEntryLockPath(tournamentId, playerId) {
      return /databases/$(database)/documents/teamEntries/$(tournamentId.lower() + '_' + playerId.lower());
    }

    function holdsTeamEntryLock(registrationId) {
      return getAfter(teamEntryLockPath(request.resource.data.tournamentId, request.resource.data.playerId))
        .data.registrationId == registrationId;
    }

    // Cricket tournaments must use the team format.
    function teamFormatForTeamSport() {
      return request.resource.data.get('sportType', '') != 'cricket'
        || request.resource.data.get('formatRaw', '') == 'team';
    }

    // ─── Players ────────────────────────────────────────
    // Gender is set once: it may only go from missing / preferNotToSay to
    // male or female (mixed Open Play counts it). Older apps write the whole
    // profile back, so an unchanged value always passes, and a missing value
    // may be written back as preferNotToSay (their decoded default).
    function genderChangeAllowed() {
      let before = resource.data.get('genderRaw', '');
      let after = request.resource.data.get('genderRaw', '');
      return after == before
        || (before in ['', 'preferNotToSay']
            && after in ['male', 'female', 'preferNotToSay']);
    }

    // The caller's own player doc. Player ids in sessions are UPPERCASE, but
    // profiles created on the web have lower-case doc ids.
    function isOwnPlayer(playerId) {
      let exact = /databases/$(database)/documents/players/$(playerId);
      let lower = /databases/$(database)/documents/players/$(playerId.lower());
      return (exists(exact) ? get(exact) : get(lower)).data.firebaseUid == request.auth.uid;
    }

    match /players/{playerId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.firebaseUid == request.auth.uid
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.email)
        && request.resource.data.elo == 1200
        && request.resource.data.streak == 0;

      // Users can only update safe profile fields — not elo, streak, firebaseUid, email
      allow update: if isAuthenticated()
        && resource.data.firebaseUid == request.auth.uid
        && unchanged('firebaseUid')
        && genderChangeAllowed()
        && unchanged('email')
        // Optional on older player docs: unchanged() errors (deny) on a missing field.
        && unchangedOptional('elo')
        && unchangedOptional('streak')
        && unchangedOptional('createdAt')
        && onlyUpdates(['name', 'phone', 'genderRaw', 'avatarId',
            'homeCountryCode', 'homePostalCode', 'weightKg',
            'dateOfBirth', 'fcmToken', 'preferredSport',
            'playingHand', 'skillLevel']);

      allow delete: if false;
    }

    // ─── Tournaments ────────────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && isNonEmptyString(request.resource.data.title)
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && isNonEmptyString(request.resource.data.location)
        && request.resource.data.date is timestamp
        && hasLiveSportOrNone()
        && teamFormatForTeamSport()
        // registrationCount is server-maintained (registration triggers);
        // autoDraw / deadlineReminderFor by the scheduled draw job.
        && !request.resource.data.keys().hasAny(['registrationCount', 'autoDraw', 'deadlineReminderFor']);

      // Only the organizer can update, and they cannot change createdBy
      allow update: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid
        && unchanged('createdBy')
        && unchangedOptional('registrationCount')
        && unchangedOptional('autoDraw')
        && unchangedOptional('deadlineReminderFor')
        && sportUnchangedOrLive()
        && teamFormatForTeamSport();

      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // ─── Registrations ──────────────────────────────────
    match /registrations/{registrationId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && isNonEmptyString(request.resource.data.tournamentId)
        && isNonEmptyString(request.resource.data.playerId)
        // memberUids is server-maintained (registration triggers).
        && !('memberUids' in request.resource.data)
        && teamEntryIfTeamEvent(registrationId);

      // Doubles: pick a partner. Team sports: who plays for this event
      // (roster, guests), their roles, or the shown team name.
      allow update: if isAuthenticated()
        && onlyUpdates(['partnerId', 'rosterIds', 'guestNames', 'teamName',
                        'captainId', 'viceCaptainId', 'keeperId', 'playerRoles']);

      // Only the registrant can delete their own registration
      allow delete: if isAuthenticated();
    }

    // ─── Team entry locks ───────────────────────────────
    // teamEntries/{tournamentId}_{playerId}: one per person per tournament,
    // created with their team registration (see holdsTeamEntryLock).
    match /teamEntries/{entryId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && entryId == request.resource.data.tournamentId.lower() + '_' + request.resource.data.playerId.lower()
        && getAfter(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
             .data.playerId == request.resource.data.playerId;

      // Never overwritten: a second entry by the same person fails here.
      allow update: if false;

      // Freed together with (or after) its registration. Older entries have
      // no lock, so deleting a missing one is allowed.
      allow delete: if isAuthenticated()
        && (resource == null
            || !existsAfter(/databases/$(database)/documents/registrations/$(resource.data.registrationId)));
    }

    // ─── Teams (team sports: cricket first) ─────────────
    match /teams/{teamId} {
      allow read: if true;

      // A team belongs to one sport, which must be live.
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.name.size() <= 40
        && isNonEmptyString(request.resource.data.captainId)
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() <= 30
        && request.resource.data.sportType in liveSports();

      // The creator manages the team. Anyone signed in may only add or
      // remove one player at a time (joining by invite link, or leaving).
      allow update: if isAuthenticated()
        && unchanged('createdBy')
        && unchanged('sportType')
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() <= 30
        && (resource.data.createdBy == request.auth.uid
            || (onlyUpdates(['playerIds'])
                && (request.resource.data.playerIds.size() - resource.data.playerIds.size() == 1
                    || resource.data.playerIds.size() - request.resource.data.playerIds.size() == 1)));

      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // ─── Matches ────────────────────────────────────────
    // Tournament ids are UPPERCASE from the apps; fall back to lower case for
    // tournaments created with lower-case doc ids.
    function isOrganizerOf(tournamentId) {
      let exact = /databases/$(database)/documents/tournaments/$(tournamentId);
      let lower = /databases/$(database)/documents/tournaments/$(tournamentId.lower());
      return (exists(exact) ? get(exact) : get(lower)).data.createdBy == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if true;

      // Only the tournament organizer creates matches (bracket generation).
      // eloApplied (Elo is applied once, by the server) and teamAUids /
      // teamBUids (participants' auth uids) are server-only.
      allow create: if isAuthenticated()
        && isNonEmptyString(request.resource.data.tournamentId)
        && !request.resource.data.keys().hasAny(['eloApplied', 'teamAUids', 'teamBUids'])
        && isOrganizerOf(request.resource.data.tournamentId);

      // Authenticated users can update scores/status
      allow update: if isAuthenticated()
        && unchanged('tournamentId')
        && unchanged('teamAId')
        && unchanged('teamBId')
        // round/bracketPosition/createdAt are absent on round-robin, group, Swiss and
        // manual-draw matches; unchanged() would error and deny every score update.
        && unchangedOptional('round')
        && unchangedOptional('bracketPosition')
        && unchangedOptional('createdAt')
        && unchangedOptional('eloApplied')
        && unchangedOptional('teamAUids')
        && unchangedOptional('teamBUids');

      // Only the organizer deletes matches (reset bracket)
      allow delete: if isAuthenticated()
        && isOrganizerOf(resource.data.tournamentId);
    }

    // ─── Standings ──────────────────────────────────────
    // standings/{tournamentId} is rebuilt by the server on every match write.
    match /standings/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Ratings ────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isNonEmptyString(request.resource.data.playerId)
        && isNonEmptyString(request.resource.data.raterId)
        && request.resource.data.raterId == request.auth.uid
        && request.resource.data.playerId != request.resource.data.raterId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;

      allow update: if false;
      allow delete: if false;
    }

    // ─── Calorie Records ────────────────────────────────
    match /calorieRecords/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // ─── Play Sessions ──────────────────────────────────
    // Newer apps write sessions only through callables; these rules keep
    // older apps (iOS 1.7, Android 1.0) to their legitimate writes. Clashes
    // and mixed-gender overflow are cleaned up by onSessionJoined, host
    // limits/overlaps by onPlaySessionCreated.

    // Written only by the server.
    function sessionServerFields() {
      return ['maxPlayers', 'endsAt', 'waitlistIds', 'attendeeUids',
              'autoRemoved', 'autoCancelled'];
    }

    // Locked once anyone besides the host has joined.
    function sessionKeyFields() {
      return ['date', 'durationMinutes', 'gameType', 'sportType',
              'costPerPerson', 'venue', 'venueAddress'];
    }

    // Stored as `gameType`. Singles 2, everything else (doubles, mixed, any) 4.
    function sessionCap(gameType) {
      return gameType == 'singles' ? 2 : 4;
    }

    function sessionChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The caller added exactly their own player id, while the session is
    // active, has not started, and has room.
    function joinedSelf(before, after) {
      return after.size() == before.size() + 1
        && before.removeAll(after).size() == 0
        && after.removeAll(before).size() == 1
        && resource.data.get('status', 'active') == 'active'
        && request.time < resource.data.date
        && after.size() <= sessionCap(request.resource.data.get('gameType', 'any'))
        && isOwnPlayer(after.removeAll(before)[0]);
    }

    // The caller removed exactly their own player id.
    function leftSelf(before, after) {
      return before.size() == after.size() + 1
        && after.removeAll(before).size() == 0
        && before.removeAll(after).size() == 1
        && isOwnPlayer(before.removeAll(after)[0]);
    }

    function attendeeChangeAllowed() {
      let before = resource.data.get('attendeeIds', []);
      let after = request.resource.data.get('attendeeIds', []);
      return !('attendeeIds' in sessionChanged())
        || (after is list && (joinedSelf(before, after) || leftSelf(before, after)));
    }

    // Host may cancel or finish an active session, never reopen one (a
    // session the server cancelled stays cancelled).
    function sessionStatusChangeAllowed() {
      return !('status' in sessionChanged())
        || (resource.data.get('status', 'active') == 'active'
            && request.resource.data.get('status', '') in ['cancelled', 'completed']);
    }

    // Older apps send the full session on every host edit (iOS merge, Android
    // update), so unchanged key fields pass; only real changes are locked.
    function hostEditAllowed() {
      return sessionStatusChangeAllowed()
        && (resource.data.get('attendeeIds', []).size() <= 1
            || !sessionChanged().hasAny(sessionKeyFields()));
    }

    function sessionAttendeesOnCreate() {
      let ids = request.resource.data.get('attendeeIds', []);
      return ids is list
        && (ids.size() == 0 || (ids.size() == 1 && isOwnPlayer(ids[0])));
    }

    match /playSessions/{sessionId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.hostId == request.auth.uid
        && isNonEmptyString(request.resource.data.venue)
        && request.resource.data.date is timestamp
        && request.resource.data.get('sportType', '') != 'cricket'
        && request.resource.data.get('status', 'active') == 'active'
        && !request.resource.data.keys().hasAny(sessionServerFields())
        && sessionAttendeesOnCreate()
        && hasLiveSportOrNone();

      // Host: edits (key fields locked once others joined), cancel/finish.
      // Anyone: join or leave themselves, nothing else.
      allow update: if isAuthenticated()
        && unchanged('hostId')
        && unchangedOptional('createdAt')
        && !sessionChanged().hasAny(sessionServerFields())
        && (!('sportType' in sessionChanged())
            || request.resource.data.get('sportType', '') != 'cricket')
        && attendeeChangeAllowed()
        && (resource.data.hostId == request.auth.uid
            ? hostEditAllowed()
            : sessionChanged().hasOnly(['attendeeIds']))
        && sportUnchangedOrLive();

      allow delete: if isAuthenticated()
        && resource.data.hostId == request.auth.uid;
    }

    // ─── Notifications ──────────────────────────────────
    match /notifications/{notifId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid;

      // Only Cloud Functions should create notifications
      allow create: if false;

      // Users can mark their own notifications as read
      allow update: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid
        && onlyUpdates(['read']);

      // Users can delete their own notifications
      allow delete: if isAuthenticated()
        && resource.data.recipientId == request.auth.uid;
    }

    // ─── App Config ─────────────────────────────────────
    // `config/app` holds the minimum supported app versions; `config/sports`
    // holds the sport catalog (live vs soon, categories). Readable before
    // sign-in so the update gate and sport picker can run on the welcome
    // screen. Edited only from the Firebase console / Admin SDK.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Deny everything else ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
