{
  "name": "tournmate-server",
  "description": "Firebase Cloud Functions backend for TournMate sports tournament app",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src/ --ext .ts",
    "seed:test-users": "npm run build && node lib/scripts/seedTestUsers.js",
    "seed:sports-config": "npm run build && node lib/scripts/seedSportsConfig.js",
    "seed:qa-cricket": "npm run build && node lib/scripts/seedQaCricket.js",
    "backfill:registration-counts": "npm run build && node lib/scripts/backfillRegistrationCounts.js",
    "check:scoring": "npm run build && node lib/scripts/checkScoring.js",
    "check:cricket": "npm run build && node lib/scripts/checkCricket.js",
    "check:openplay": "npm run build && node lib/scripts/checkOpenPlay.js",
    "check:draw": "npm run build && node lib/scripts/checkDraw.js",
    "test:draw-emulator": "npm run build && cd .. && firebase emulators:exec --only firestore,functions --project demo-tournmate \"node functions/lib/scripts/emulatorDrawTest.js\"",
    "qa:seed": "npm run build && node lib/scripts/seedQaTournaments.js",
    "qa:checks": "npm run build && node lib/scripts/qaServerChecks.js",
    "qa:cleanup": "npm run build && node lib/scripts/cleanupQaTournaments.js",
    "backfill:member-uids": "npm run build && node lib/scripts/backfillMemberUids.js",
    "check:prod-data": "npm run build && node lib/scripts/checkProdData.js",
    "test:emulator-core": "npm run build && firebase emulators:exec --only firestore --project demo-tournmate \"node lib/scripts/emulatorCoreChecks.js\""
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "typescript": "^5.4.0"
  },
  "private": true
}
